{
  "name": "lariba-docs-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "NEXT_DISABLE_TURBOPACK=1 next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --include=dev --audit-level=moderate",
    "audit:deps": "npm run audit:prod && npm run audit:dev"
  },
  "dependencies": {
    "@laribacloud/lariba-sdk-js": "github:node63labs/lariba-sdk-js",
    "lariba-sdk": "github:node63labs/lariba-sdk-js",
    "next": "16.3.5",
    "nextra": "2.13.4",
    "nextra-theme-docs": "2.13.4",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "overrides": {
    "dompurify": "^3.4.7",
    "flatted": "^3.4.2",
    "lodash-es": "^4.18.1",
    "mermaid": "^11.15.0",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.15"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "^5.0.6"
    },
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8.5.10",
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "title": "^4.0.1",
    "uuid": "^11.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
